# Auth0 Configuration - UPDATE THESE VALUES
# Get these from https://manage.auth0.com/dashboard/
# 1. Create Application → Regular Web Application
# 2. Set Allowed Callback URLs: http://localhost:3000/auth/callback
# 3. Set Allowed Logout URLs: http://localhost:3000
# 4. Set Allowed Web Origins: http://localhost:3000

AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_SECRET=generate-a-32-character-random-string
APP_BASE_URL=http://localhost:3000
